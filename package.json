{
  "name": "codingspace",
  "version": "1.0.0",
  "description": "Terminal workspace manager with git worktree and tmux support",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/app.js --bundle --outfile=dist/renderer/app.bundle.js --platform=browser --format=iife --target=chrome120",
    "start": "npm run build:renderer && electron ."
  },
  "keywords": [
    "terminal",
    "worktree",
    "tmux",
    "workspace"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
