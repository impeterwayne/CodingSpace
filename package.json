{
  "name": "codingspace",
  "version": "1.0.0",
  "description": "Terminal workspace manager with git worktree and tmux support",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/app.js --bundle --outfile=dist/renderer/app.bundle.js --platform=browser --format=iife --target=chrome120",
    "start": "npm run build:renderer && electron .",
    "pack": "npm run build:renderer && electron-builder --dir",
    "make": "npm run build:renderer && electron-builder",
    "make:win": "npm run build:renderer && electron-builder --win"
  },
  "keywords": [
    "terminal",
    "worktree",
    "tmux",
    "workspace"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.codingspace.app",
    "productName": "Coding Space",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Coding Space",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
